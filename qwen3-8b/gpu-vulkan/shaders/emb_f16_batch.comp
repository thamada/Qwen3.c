#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_GOOGLE_include_directive : enable
#include "common.inc"

layout(local_size_x = 256, local_size_y = 1) in;

layout(set = 0, binding = 0) buffer OutBuf { float o[]; };
layout(set = 0, binding = 1) readonly buffer WBuf { uint16_t w[]; };
layout(set = 0, binding = 2) readonly buffer TokBuf { int tokens[]; };

layout(push_constant) uniform PC {
    int dim;
    int n_tokens;
} pc;

void main()
{
    uint t = gl_GlobalInvocationID.y;
    uint i = gl_GlobalInvocationID.x;
    if (int(t) >= pc.n_tokens || int(i) >= pc.dim) return;
    o[t * uint(pc.dim) + i] =
        f16_to_f32(uint(w[uint(tokens[t]) * uint(pc.dim) + i]));
}
