#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer OutBuf { float o[]; };
layout(set = 0, binding = 1) readonly buffer XBuf { float x[]; };
layout(set = 0, binding = 2) readonly buffer WBuf { float w[]; };

layout(push_constant) uniform PC {
    int n;
    int n_tokens;
    float eps;
} pc;

shared float ssum[256];

void main()
{
    int t = int(gl_WorkGroupID.x);
    if (t >= pc.n_tokens) return;
    uint lid = gl_LocalInvocationID.x;

    int base = t * pc.n;
    float local = 0.0;
    for (int i = int(lid); i < pc.n; i += 256)
        local += x[base + i] * x[base + i];
    ssum[lid] = local;
    barrier();
    for (int s = 128; s > 0; s >>= 1) {
        if (int(lid) < s) ssum[lid] += ssum[lid + uint(s)];
        barrier();
    }
    float ss = inversesqrt(ssum[0] / float(pc.n) + pc.eps);
    for (int i = int(lid); i < pc.n; i += 256)
        o[base + i] = x[base + i] * ss * w[i];
}
