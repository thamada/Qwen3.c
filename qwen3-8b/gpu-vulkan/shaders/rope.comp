#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer VecBuf { float vec[]; };

layout(push_constant) uniform PC {
    int n_heads;
    int head_dim;
    int pos;
    float theta_base;
} pc;

void main()
{
    int pairs = pc.n_heads * (pc.head_dim / 2);
    int p = int(gl_GlobalInvocationID.x);
    if (p >= pairs) return;

    int h = p / (pc.head_dim / 2);
    int pr = p % (pc.head_dim / 2);
    int i = pr * 2;
    float freq = 1.0 / pow(pc.theta_base, float(i) / float(pc.head_dim));
    float angle = float(pc.pos) * freq;
    float cr = cos(angle);
    float ci = sin(angle);
    int idx = h * pc.head_dim + i;
    float v0 = vec[idx];
    float v1 = vec[idx + 1];
    vec[idx]     = v0 * cr - v1 * ci;
    vec[idx + 1] = v0 * ci + v1 * cr;
}
