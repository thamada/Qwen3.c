#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer HbBuf { float hb[]; };
layout(set = 0, binding = 1) readonly buffer Hb2Buf { float hb2[]; };

layout(push_constant) uniform PC {
    int n;
    int n_tokens;
} pc;

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    int total = pc.n * pc.n_tokens;
    if (i >= total) return;
    float v = hb[i];
    v = v / (1.0 + exp(-v));
    hb[i] = v * hb2[i];
}
